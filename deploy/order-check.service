# ============================================================
# 订单查重系统 - FastAPI 后端 systemd 服务
# 部署位置: /etc/systemd/system/order-check.service
#
# 说明：
#   - 单 worker 运行：SQLite 数据库 + 内存缓存，多 worker 会导致
#     数据一致性问题，因此这里固定 --workers 1
#   - 以 www-data 用户运行，便于读写 /opt/order-check/data/
# ============================================================

[Unit]
Description=Order Check FastAPI Backend
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data

# 后端工作目录（main.py 所在目录）
WorkingDirectory=/opt/order-check/backend

# 启动命令：监听 127.0.0.1:8003，仅内网由 Nginx 反代
ExecStart=/opt/order-check/backend/.venv/bin/uvicorn main:app --host 127.0.0.1 --port 8003 --workers 1

Restart=always
RestartSec=3

Environment=PYTHONUNBUFFERED=1

# 上传/输出文件较多时提高文件描述符上限
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
